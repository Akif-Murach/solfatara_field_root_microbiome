#!/bin/bash\
# 06_Plant_nblast.sh\
#\
# Purpose:\
#   Identify the most similar reference leaf sequences for plant root\
#   sequences using local BLAST.\
#\
# Input:\
#   Data/Plant/Leaf.fasta\
#   Data/Plant/Root.fasta\
#\
# Output:\
#   Output/02_Plant_root_identification/Local_Blast/Leaf_db.*\
#   Output/02_Plant_root_identification/Local_Blast/Leaf_Root_blast.tsv\
#\
# Requirements:\
#   - BLAST+ (makeblastdb, blastn)\
#\
# Notes:\
#   - The reference database is constructed from leaf sequences.\
#   - Root sequences are used as queries against the leaf database.\
#   - The top 5 hits with E-value <= 1e-20 are retained.\
\
set -euo pipefail\
\
# ============================================================\
# 0. Project directory\
# ============================================================\
\
cd "$(git rev-parse --show-toplevel)"\
\
# ============================================================\
# 1. Parameters\
# ============================================================\
\
THREADS=8\
MAX_TARGET_SEQS=5\
EVALUE=1e-20\
\
# ============================================================\
# 2. Input / output paths\
# ============================================================\
\
LEAF_FASTA="Data/Plant/Leaf.fasta"\
ROOT_FASTA="Data/Plant/Root.fasta"\
\
OUTPUT_DIR="Output/02_Plant_root_identification/Local_Blast"\
DB_PREFIX="$\{OUTPUT_DIR\}/Leaf_db"\
BLAST_OUTPUT="$\{OUTPUT_DIR\}/Leaf_Root_blast.tsv"\
\
# ============================================================\
# 3. Prepare output directory\
# ============================================================\
\
mkdir -p "$\{OUTPUT_DIR\}"\
\
# ============================================================\
# 4. Create BLAST database\
# ============================================================\
\
echo "Creating BLAST database from leaf sequences..."\
\
makeblastdb \\\
  -in "$\{LEAF_FASTA\}" \\\
  -dbtype nucl \\\
  -out "$\{DB_PREFIX\}"\
\
# ============================================================\
# 5. Perform local BLAST\
# ============================================================\
\
echo "Running BLAST..."\
\
blastn \\\
  -query "$\{ROOT_FASTA\}" \\\
  -db "$\{DB_PREFIX\}" \\\
  -out "$\{BLAST_OUTPUT\}" \\\
  -outfmt "6 qseqid sseqid pident length mismatch gapopen qstart qend sstart send evalue bitscore qlen slen" \\\
  -max_target_seqs "$\{MAX_TARGET_SEQS\}" \\\
  -evalue "$\{EVALUE\}" \\\
  -num_threads "$\{THREADS\}"\
\
echo "BLAST analysis completed."\
echo "Output: $\{BLAST_OUTPUT\}"}